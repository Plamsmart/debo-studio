# Copia este archivo a .env.local y completa los valores.
# Recuerda: cada variable nueva también debe agregarse en Vercel (Production)
# y redesplegar (ver bug #13 en AGENTS.md).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SERVICE_ROLE=

# Resend
RESEND_API_KEY=
STUDIO_NOTIFICATION_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sitio
NEXT_PUBLIC_SITE_URL=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Si es "true", los eventos del Google Calendar del negocio bloquean horarios
# en /reservar y en el chatbot (además de las citas de la base de datos).
# Apagado por defecto: activarlo recién cuando la app pase a producción real
# (y con la app de Google fuera de modo Testing, donde el token caduca cada 7 días).
GOOGLE_CALENDAR_BLOQUEA_DISPONIBILIDAD=false

# Chatbot
OPENAI_API_KEY=
CHAT_IP_SALT=
